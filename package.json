{
  "name": "mapica-web",
  "private": true,
  "version": "1.0.0",
  "description": "Public landing pages for mapica.app/route/:slug",
  "scripts": {
    "build": "npm run build:api",
    "build:api": "esbuild api/local.ts --bundle --platform=node --format=cjs --outfile=api/local.js --external:@vercel/node && esbuild api/follow.ts --bundle --platform=node --format=cjs --outfile=api/follow.js --external:@vercel/node",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@vercel/node": "^5.1.8"
  }
}
